# Variables que usa api/contact.js para enviar el formulario por SMTP.
# NO poner los valores reales aqui: se configuran en Vercel
# (Settings -> Environment Variables). Este archivo es solo referencia.

SMTP_HOST=mail.barmoredsecurity.com
SMTP_PORT=465
SMTP_USER=abraham.karam@barmoredsecurity.com
SMTP_PASS=la-contrasena-del-buzon
# Opcional: destino de los mensajes. Si se omite, usa SMTP_USER.
CONTACT_TO=abraham.karam@barmoredsecurity.com
